# Projeto Supabase EXCLUSIVO da Aden (Settings → API).
# Sem estas variáveis o sistema abre em "modo demonstração" (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Força o modo demonstração mesmo com as variáveis acima (só para testes locais).
NEXT_PUBLIC_MODO_DEMO=

# Conector do Claude (servidor): usuário do Supabase com o qual o conector entra (ver docs/SETUP.md).
ADEN_MCP_EMAIL=
ADEN_MCP_SENHA=
# Senha única do endereço antigo do conector (desligado em 30/09/2026; deixe vazio).
ADEN_MCP_TOKEN=

# Assinatura eletrônica dos contratos (Autentique). Só no servidor.
AUTENTIQUE_TOKEN=
# 1 = modo teste da Autentique (contratos sem validade jurídica).
AUTENTIQUE_SANDBOX=

# Quiz de conversão de leads (página pública /quiz). Segredo que só a rota /api/quiz conhece: a mesma frase
# (24 letras ou mais, só letras e números) vai aqui e, como hash, na tabela quiz_segredo (docs/SETUP.md). Sem ele o quiz fica fora do ar.
QUIZ_SEGREDO=

# Instagram e Facebook (conexão com a Meta, etapa 1: só leitura). Só no servidor. Tudo desligado por padrão.
# 1 = liga a conferência da conexão (ficha do cliente e conector). Vazio = desligado.
META_CONEXAO_ATIVA=
# Token do usuário do sistema da Meta. NUNCA em código, banco, log, commit ou chat: só na Vercel.
META_ACCESS_TOKEN=
# Opcionais: com ID e segredo do app o cartão mostra quando o acesso vence.
META_APP_ID=
META_APP_SECRET=
# Opcional (não é segredo): ID do negócio da Aden que vai no passo a passo do cliente.
META_NEGOCIO_ID=
# Opcional: versão da Graph API (padrão v23.0).
META_GRAPH_VERSION=
