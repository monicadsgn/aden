# Projeto Supabase EXCLUSIVO da Aden (Settings → API).
# Sem estas variáveis o sistema abre em "modo demonstração" (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Força o modo demonstração mesmo com as variáveis acima (só para testes locais).
NEXT_PUBLIC_MODO_DEMO=

# Conector do Claude (servidor): usuário do Supabase com o qual o conector entra (ver docs/SETUP.md).
ADEN_MCP_EMAIL=
ADEN_MCP_SENHA=
# Senha única do endereço antigo do conector (desligado em 30/09/2026; deixe vazio).
ADEN_MCP_TOKEN=

# Assinatura eletrônica dos contratos (Autentique). Só no servidor.
AUTENTIQUE_TOKEN=
# 1 = modo teste da Autentique (contratos sem validade jurídica).
AUTENTIQUE_SANDBOX=
